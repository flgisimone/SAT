{
  "name": "seo-accessibility-tool",
  "version": "1.18.0",
  "author": "Giulio Simone Floresta",
  "license": "MIT",
  "type": "module",
  "description": "Visual accessibility and SEO debugger for web apps: a panel in your dev server that shows WCAG, ARIA and SEO issues on the page, plus a Playwright helper and a CLI for CI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sat-check": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.js",
      "types": "./dist/vue.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./sat-controller": {
      "import": "./dist/sat-controller.js",
      "types": "./dist/sat-controller.d.ts"
    },
    "./axe": {
      "import": "./dist/axe.js",
      "types": "./dist/axe.d.ts"
    },
    "./playwright": {
      "import": "./dist/playwright.js",
      "types": "./dist/playwright.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "aria",
    "seo",
    "seo-audit",
    "accessibility-testing",
    "devtools",
    "debugger",
    "react",
    "vue",
    "svelte",
    "vite",
    "vite-plugin",
    "playwright",
    "axe-core",
    "ci",
    "browser-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flgisimone/SAT.git"
  },
  "bugs": {
    "url": "https://github.com/flgisimone/SAT/issues"
  },
  "homepage": "https://github.com/flgisimone/SAT#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup -c && rollup -c rollup.dts.config.cjs",
    "dev": "rollup -c -w",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build -- --silent && playwright test",
    "verify": "tsc --noEmit && eslint . && vitest run --reporter=agent --silent=passed-only && rollup -c --silent && rollup -c rollup.dts.config.cjs --silent",
    "verify:e2e": "rollup -c --silent && playwright test --reporter=dot",
    "usage": "node scripts/token-usage.mjs",
    "smoke": "rollup -c --silent && rollup -c rollup.dts.config.cjs --silent && node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "axe-core": "^4.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "vite": ">=5.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.13.10",
    "@types/react": "^18.2.14",
    "axe-core": "^4.10.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "rollup": "^4.35.0",
    "rollup-plugin-dts": "^6.5.1",
    "svelte": "^5.57.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  }
}
