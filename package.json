{
  "name": "seo-accessibility-tool",
  "version": "1.1.0",
  "description": "A11y SEO Accessibility tool for React and Vue projects",
  "author": "Giulio Simone Floresta",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.js",
      "types": "./dist/vue.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "accessibility",
    "seo",
    "heading",
    "react",
    "vue",
    "lighthouse",
    "a11y",
    "aria",
    "html5",
    "semantic"
  ],
  "scripts": {
    "build": "rollup -c && rollup -c rollup.dts.config.cjs",
    "dev": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.35.0",
    "rollup-plugin-dts": "^6.1.0",
    "typescript": "^5.8.2",
    "@types/react": "^19.0.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0 || ^3.5.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
