{
  "name": "seo-accessibility-tool",
  "version": "1.7.0",
  "author": "Giulio Simone Floresta",
  "license": "MIT",
  "type": "module",
  "description": "Universal Accessibility & SEO Checker (React, Vue, Vanilla)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.js",
      "types": "./dist/vue.d.ts"
    },
    "./sat-controller": {
      "import": "./dist/sat-controller.js",
      "types": "./dist/sat-controller.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "accessibility",
    "seo",
    "a11y",
    "react",
    "vue",
    "lighthouse",
    "html5",
    "semantic",
    "aria",
    "checker",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flgisimone/sat"
  },
  "bugs": {
    "url": "https://github.com/flgisimone/SAT/issues"
  },
  "homepage": "https://github.com/flgisimone/sat",
  "scripts": {
    "build": "rollup -c && rollup -c rollup.dts.config.cjs",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && playwright test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.52",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.13.10",
    "@types/react": "^18.2.14",
    "happy-dom": "^17.6.3",
    "react": "^18.3.1",
    "rollup": "^4.35.0",
    "rollup-plugin-dts": "^6.1.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7",
    "vue": "^3.5.44"
  }
}
