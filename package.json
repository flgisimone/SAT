{
  "name": "seo-accessibility-tool",
  "version": "1.4.2",
  "author": "Giulio Simone Floresta",
  "license": "MIT",
  "type": "module",
  "description": "Universal Accessibility & SEO Checker (React, Vue, Vanilla)",
  "repository": {
    "type": "git",
    "url": "https://github.com/flgisimone/sat"
  },
  "bugs": {
    "url": "https://github.com/flgisimone/SAT/issues"
  },
  "homepage": "https://github.com/flgisimone/sat",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.js",
      "types": "./dist/vue.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "accessibility",
    "seo",
    "heading",
    "react",
    "vue",
    "lighthouse",
    "a11y",
    "aria",
    "html5",
    "semantic"
  ],
  "scripts": {
    "build": "rollup -c && rollup -c rollup.dts.config.cjs",
    "dev": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "rollup": "^4.35.0",
    "rollup-plugin-dts": "^6.1.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
